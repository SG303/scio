# Docker Compose Template
# Copy this file to docker-compose.yml and adjust the values as needed.
# The OpenRouter API key can be entered in the app (Settings → AI providers)
# or set via the OPENROUTER_API_KEY environment variable.

services:
  scio:
    build: .
    container_name: scio
    ports:
      - "8001:8000"
    volumes:
      - ./data:/app/data
      - ./uploads:/app/uploads
      - ./claude:/app/claude  # Claude Code CLI + sign-in for the Claude subscription
    environment:
      - OPENROUTER_API_KEY=${OPENROUTER_API_KEY}  # Optional: can also be set in the app
    restart: unless-stopped

